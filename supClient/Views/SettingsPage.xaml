<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:supClient.ViewModels"
             x:Class="supClient.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             Title="Настройки">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            <VerticalStackLayout Spacing="8">
                <Label Text="Количество SUP-досок"
                       FontAttributes="Bold" />
                <Stepper Minimum="1"
                         Maximum="100"
                         Value="{Binding TotalBoards}"
                         Increment="1" />
                <Label Text="{Binding TotalBoards, StringFormat='Всего досок: {0}'}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Длительность брони по умолчанию"
                       FontAttributes="Bold" />
                <Stepper Minimum="1"
                         Maximum="12"
                         Value="{Binding DefaultBookingDurationHours}"
                         Increment="1" />
                <Label Text="{Binding DefaultBookingDurationHours, StringFormat='Часов: {0}'}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Button Text="Сохранить"
                    Command="{Binding SaveCommand}" />

            <BoxView HeightRequest="1"
                     Color="{StaticResource Gray200}" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Локальные данные"
                       FontAttributes="Bold" />
                <Button Text="Удалить все брони"
                        Command="{Binding DeleteAllBookingsCommand}"
                        BackgroundColor="#B3261E"
                        TextColor="White" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
