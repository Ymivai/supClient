<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="supClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:supClient.Localization"
    xmlns:vm="clr-namespace:supClient.ViewModels"
    Title="{localization:Localization Title.Settings}"
    x:DataType="vm:SettingsPageViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="24">
            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    Text="{localization:Localization Label.TotalBoardsSetting}" />
                <Stepper
                    Increment="1"
                    Maximum="100"
                    Minimum="1"
                    Value="{Binding TotalBoards}" />
                <Label
                    HorizontalOptions="Center"
                    Text="{Binding TotalBoardsDisplay}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    Text="{localization:Localization Label.DefaultBookingDuration}" />
                <Stepper
                    Increment="1"
                    Maximum="12"
                    Minimum="1"
                    Value="{Binding DefaultBookingDurationHours}" />
                <Label
                    HorizontalOptions="Center"
                    Text="{Binding DefaultBookingDurationDisplay}" />
            </VerticalStackLayout>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        Text="{localization:Localization Label.WeekdayHourlyRate}" />
                    <Entry
                        Keyboard="Numeric"
                        Text="{Binding WeekdayHourlyRate}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        Text="{localization:Localization Label.WeekendHourlyRate}" />
                    <Entry
                        Keyboard="Numeric"
                        Text="{Binding WeekendHourlyRate}" />
                </VerticalStackLayout>
            </Grid>

            <Button
                Command="{Binding SaveCommand}"
                Text="{localization:Localization Button.Save}" />

            <BoxView
                HeightRequest="1"
                Color="Gray" />

            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    Text="{localization:Localization Label.LocalData}" />
                <Button
                    BackgroundColor="#B3261E"
                    Command="{Binding DeleteAllBookingsCommand}"
                    Text="{localization:Localization Button.DeleteAllBookings}"
                    TextColor="White" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
