<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="supClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:supClient.ViewModels"
    Title="Настройки"
    x:DataType="vm:SettingsPageViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="24">
            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    Text="Количество SUP-досок" />
                <Stepper
                    Increment="1"
                    Maximum="100"
                    Minimum="1"
                    Value="{Binding TotalBoards}" />
                <Label
                    HorizontalOptions="Center"
                    Text="{Binding TotalBoards, StringFormat='Всего досок: {0}'}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    Text="Длительность брони по умолчанию" />
                <Stepper
                    Increment="1"
                    Maximum="12"
                    Minimum="1"
                    Value="{Binding DefaultBookingDurationHours}" />
                <Label
                    HorizontalOptions="Center"
                    Text="{Binding DefaultBookingDurationHours, StringFormat='Часов: {0}'}" />
            </VerticalStackLayout>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        Text="Рабочий день, грн/час" />
                    <Entry
                        Keyboard="Numeric"
                        Text="{Binding WeekdayHourlyRate}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        Text="Выходной, грн/час" />
                    <Entry
                        Keyboard="Numeric"
                        Text="{Binding WeekendHourlyRate}" />
                </VerticalStackLayout>
            </Grid>

            <Button
                Command="{Binding SaveCommand}"
                Text="Сохранить" />

            <BoxView
                HeightRequest="1"
                Color="Gray" />

            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    Text="Локальные данные" />
                <Button
                    BackgroundColor="#B3261E"
                    Command="{Binding DeleteAllBookingsCommand}"
                    Text="Удалить все брони"
                    TextColor="White" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
