<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:supClient.ViewModels"
             x:Class="supClient.Views.AddBookingPage"
             x:DataType="vm:AddBookingPageViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <VerticalStackLayout Spacing="8">
                <Label Text="Дата" FontAttributes="Bold" />
                <DatePicker Date="{Binding BookingDate}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Время начала" FontAttributes="Bold" />
                <TimePicker Time="{Binding StartTime}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Длительность" FontAttributes="Bold" />
                <Stepper Minimum="1"
                         Maximum="12"
                         Value="{Binding DurationHours}"
                         Increment="1" />
                <Label Text="{Binding DurationHours, StringFormat='Часов: {0}'}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Количество SUP" FontAttributes="Bold" />
                <Stepper Minimum="1"
                         Maximum="20"
                         Value="{Binding BoardsCount}"
                         Increment="1" />
                <Label Text="{Binding BoardsCount, StringFormat='Выбрано: {0}'}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Клиент" FontAttributes="Bold" />
                <Entry Placeholder="Имя или Telegram"
                       Text="{Binding ClientName}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Телефон" FontAttributes="Bold" />
                <Entry Keyboard="Telephone"
                       Placeholder="Необязательно"
                       Text="{Binding PhoneNumber}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Способ оплаты" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding PaymentMethodNames}"
                        SelectedIndex="{Binding SelectedPaymentMethodIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Комментарий" FontAttributes="Bold" />
                <Editor AutoSize="TextChanges"
                        HeightRequest="90"
                        Placeholder="Необязательно"
                        Text="{Binding Comment}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <Button Text="Сохранить"
                        Command="{Binding SaveCommand}" />
                <Button Text="Удалить бронь"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditing}"
                        BackgroundColor="#B3261E"
                        TextColor="White" />
                <Button Text="Отмена"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Gray300}"
                        TextColor="{StaticResource Gray900}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
