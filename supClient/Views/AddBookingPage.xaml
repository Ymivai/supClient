<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:supClient.Localization"
             xmlns:vm="clr-namespace:supClient.ViewModels"
             x:Class="supClient.Views.AddBookingPage"
             x:DataType="vm:AddBookingPageViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <VerticalStackLayout Spacing="8">
                <Label Text="{localization:Localization Label.Date}" FontAttributes="Bold" />
                <DatePicker Date="{Binding BookingDate}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="{localization:Localization Label.Start}" FontAttributes="Bold" />
                    <TimePicker Time="{Binding StartTime}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="{localization:Localization Label.End}" FontAttributes="Bold" />
                    <TimePicker Time="{Binding EndTime}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding DurationDisplay}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="8">
                <Label Text="{localization:Localization Label.SupCount}" FontAttributes="Bold" />
                <Stepper Minimum="1"
                         Maximum="20"
                         Value="{Binding BoardsCount}"
                         Increment="1" />
                <Label Text="{Binding BoardsCountDisplay}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{localization:Localization Label.Client}" FontAttributes="Bold" />
                <Entry Placeholder="{localization:Localization Placeholder.Client}"
                       Text="{Binding ClientName}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{localization:Localization Label.Phone}" FontAttributes="Bold" />
                <Entry Keyboard="Telephone"
                       Placeholder="{localization:Localization Placeholder.Optional}"
                       Text="{Binding PhoneNumber}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{localization:Localization Label.PaymentMethod}" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding PaymentMethodNames}"
                        SelectedIndex="{Binding SelectedPaymentMethodIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding PaymentAmountsVisible}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="{localization:Localization Label.CardPaymentAmount}" FontAttributes="Bold" />
                        <Entry Keyboard="Numeric"
                               Text="{Binding CardPaymentAmount}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="{localization:Localization Label.CashPaymentAmount}" FontAttributes="Bold" />
                        <Entry Keyboard="Numeric"
                               Text="{Binding CashPaymentAmount}" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="{Binding HasSvoParticipants}" />
                    <Label Text="{localization:Localization Label.HasSvoParticipants}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasSvoParticipants}">
                <Label Text="{localization:Localization Label.SvoParticipantsCount}" FontAttributes="Bold" />
                <Stepper Minimum="1"
                         Maximum="{Binding BoardsCount}"
                         Value="{Binding SvoParticipantsCount}"
                         Increment="1" />
                <Label Text="{Binding SvoParticipantsDisplay}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding FullHourlyPricing}" />
                <Label Text="{localization:Localization Label.FullHourlyPricing}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding BookingCostDisplay}"
                   FontAttributes="Bold"
                   FontSize="18"
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="8">
                <Label Text="{localization:Localization Label.Comment}" FontAttributes="Bold" />
                <Editor AutoSize="TextChanges"
                        HeightRequest="90"
                        Placeholder="{localization:Localization Placeholder.Optional}"
                        Text="{Binding Comment}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <Button Text="{localization:Localization Button.Save}"
                        Command="{Binding SaveCommand}" />
                <Button Text="{localization:Localization Button.DeleteBooking}"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditing}"
                        BackgroundColor="#B3261E"
                        TextColor="White" />
                <Button Text="{localization:Localization Button.Cancel}"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Gray300}"
                        TextColor="{StaticResource Gray900}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
