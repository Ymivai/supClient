<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:supClient.ViewModels"
             x:Class="supClient.Views.AddBookingPage"
             x:DataType="vm:AddBookingPageViewModel"
             Title="Новая бронь">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            <VerticalStackLayout Spacing="8">
                <Label Text="Количество SUP"
                       FontAttributes="Bold" />
                <Stepper Minimum="1"
                         Maximum="20"
                         Value="{Binding BoardsCount}"
                         Increment="1" />
                <Label Text="{Binding BoardsCount, StringFormat='Выбрано: {0}'}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Время начала"
                       FontAttributes="Bold" />
                <TimePicker Time="{Binding StartTime}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <Button Text="Сохранить"
                        Command="{Binding SaveCommand}" />
                <Button Text="Отмена"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Gray300}"
                        TextColor="{StaticResource Gray900}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
