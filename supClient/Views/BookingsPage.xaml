<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="supClient.Views.BookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:supClient.ViewModels"
    Title="SupClient"
    x:DataType="vm:BookingsPageViewModel">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16">
        <Label
            Grid.Row="0"
            FontAttributes="Bold"
            FontSize="20"
            HorizontalOptions="Center"
            Text="{Binding DateDisplay}" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Bookings}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label
                        HorizontalOptions="Center"
                        Text="На сегодня броней нет"
                        TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BookingItemViewModel">
                    <Border
                        Margin="0,0,0,8"
                        Padding="16,12"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label
                            FontSize="16"
                            Text="{Binding DisplayText}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="2"
            Command="{Binding AddBookingCommand}"
            HorizontalOptions="Fill"
            Text="Добавить бронь" />
    </Grid>
</ContentPage>
